# ==========================
# Server / runtime
# ==========================
PORT=8000
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# ==========================
# Database
# ==========================
# Local fallback example:
# DATABASE_URL=sqlite:///./webhook_events.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Startup behavior for Postgres URLs
AUTO_APPLY_MIGRATIONS=true

# ==========================
# Security / Auth
# ==========================
AUTH_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
VERIFY_TOKEN=your_meta_verify_token

# Optional sudo/admin backup login controls
SUDO_ADMIN_BACKUP=
SUDO_ADMIN_BACKUP_TOKEN=
SUDO_USER_ID=
SUDO_USER_TOKEN=

# Optional seed script defaults
CEO_USERNAME=
CEO_PASSWORD=

# ==========================
# Rate limiting / webhook guards
# ==========================
REQUEST_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_PER_WINDOW=20
WEBHOOK_RATE_LIMIT_PER_WINDOW=180
WEBHOOK_VERIFY_RATE_LIMIT_PER_WINDOW=60
WEBHOOK_MAX_BODY_BYTES=1048576

# ==========================
# Celery / Redis
# ==========================
REDIS_CONNECTION_STRING=redis://127.0.0.1:6379
# Optional explicit overrides (otherwise derived from REDIS_CONNECTION_STRING)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Retry tuning
TASK_REPEAT_COUNT=3
REPEAT_COUNT=
PROCESS_WEBHOOK_EVENT_REPEAT_COUNT=
SEND_AUTOMATION_REPLY_REPEAT_COUNT=
POST_META_CONVERSION_EVENT_REPEAT_COUNT=

# ==========================
# Instagram / Meta Graph
# ==========================
IG_AUTOREPLY_TEXT=Welcome! How can we assist you today?
IG_MESSAGING_PRODUCT=instagram
IG_GRAPH_VERSION=v25.0
META_GRAPH_VERSION=

# Business account id fallbacks: IG_ACCOUNT_ID -> INSTAGRAM_ACCOUNT_ID -> IG_USER_ID
IG_ACCOUNT_ID=
INSTAGRAM_ACCOUNT_ID=
IG_USER_ID=

# Conversions API credentials
ACCESS_TOKEN=your_meta_access_token
DATASET_ID=your_dataset_or_pixel_id
META_PIXEL_ID=
